# Frontend Next.js
# Copiar como: flowermatch/.env.local
NEXT_PUBLIC_URL_API=http://localhost:8080

# Backend PHP
# Copiar como: backend-php/.env

# development → logs verbosos | production → logs sin datos sensibles
APP_ENV=development

FRONTEND_URL=http://localhost:3000

DB_HOST=127.0.0.1
DB_USER=flowermatch_user
DB_PASSWORD=CAMBIAR_EN_LOCAL
DB_NAME=flowermatch
DB_CHARSET=utf8mb4

ADMIN_USER=admin
# Contraseña en texto plano. Generar el hash con:
#   php -r "echo password_hash('tu_contrasena', PASSWORD_DEFAULT);"
ADMIN_PASSWORD_HASH=GENERAR_CON_PASSWORD_HASH

# Solo para scripts de test locales (scripts/test-e2e-minimo.sh).
# El backend NUNCA lee esta variable — usa ADMIN_PASSWORD_HASH para autenticar.
# No añadir en producción.
# ADMIN_PASSWORD=CAMBIAR_EN_LOCAL_SOLO_PARA_TEST_E2E

ADMIN_TOKEN=GENERAR_CON_OPENSSL_RAND_HEX_32
# JWT: reemplaza a ADMIN_TOKEN en producción. Generar con: openssl rand -hex 64
JWT_SECRET=GENERAR_CON_OPENSSL_RAND_HEX_64

# Python AI
# Copiar como: python-ai/.env
DB_HOST=127.0.0.1
DB_USER=flowermatch_user
DB_PASSWORD=CAMBIAR_EN_LOCAL
DB_NAME=flowermatch
